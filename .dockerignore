# Reduz o contexto de build e — crítico — mantém segredos fora da imagem.
# Sem isto o `next build` carregaria .env.local e embutiria/vazaria segredos.
node_modules
.next
.git
.env
.env.*
**/.env
**/.env.*
# VPS-only infrastructure and operator artifacts never belong in application images.
infra
final-20261027
**/private-backups
**/*.dump
**/postgres-cluster.tar
test-results
tests
playwright.config.ts
*.png
*.log
.lina
docs
tasks
scratchpad
.vercel
# Harness de sessão de IA (skills, hooks, config de CLI): não é código de
# runtime e entrava inteiro na imagem do worker (`COPY . .`).
.claude
.agents
.agent
.codex
.cursor
.opencode
.specs
.changes

# Artefatos locais de QA não fazem parte do runtime.
evidence
.superpowers
*.tsbuildinfo

# Local deployment evidence and credential backups are never build inputs.
.local
.auth
.qa-vps
.qa-backups
backups
secrets
credentials
output
tmp
*.dump
*.sql.gz
