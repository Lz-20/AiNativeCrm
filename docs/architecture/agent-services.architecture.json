  "edges": [
    {
      "from": "sql",
      "to": "pi",
      "label": "Confirmed facts available even with Mem0 off"
    },
    {
      "from": "sql",
      "to": "eval",
      "label": "Privacy-scoped existence throughout the run, no body export"
    },
    {
      "from": "settings",
      "to": "mem0"
    },
    {
      "from": "contact",
      "to": "sql"
    },
    {
      "from": "sql",
      "to": "mem0"
    },
    {
      "from": "mem0",
      "to": "pi"
    },
    {
      "from": "settings",
      "to": "wiki"
    },
    {
      "from": "corpus",
      "to": "wiki"
    },
    {
      "from": "wiki",
      "to": "evidence"
    },
    {
      "from": "evidence",
      "to": "pi"
    },
    {
      "from": "pi",
      "to": "sql"
    },
    {
      "from": "pi",
      "to": "outbox"
    },
    {
      "from": "eval",
      "to": "outbox"
