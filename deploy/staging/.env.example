# Example only. No real credentials. Copy to the repository root as .env.staging.
# Keep .env.staging mode 0600, outside Git and image build contexts.
# Use only the isolated self-hosted Supabase staging instance.
# Runtime secrets live in a protected VPS directory, outside the build context.
# Variable sources: docs/runbooks/staging-environment.zh-CN.md.

# Candidate from the compatibility worktree; confirm the successful build before use.
# Preserve the previous image: ainativecrm-staging-app:f77e371-arm64-r1.
STAGING_IMAGE_TAG=final-20261027-r3
NODE_ENV=production
CRM_DEMO_MODE=false
SIGNUP_MODE=so_convite
SENTRY_DSN=off
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# All four must point to the SAME staging project. Never use production values.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
# Self-host: browser via SSH uses http://localhost:8000; containers use http://api-gw:8000.
# Leave empty for Cloud. Never publish this server-only binding in __PUBLIC_ENV__.
SUPABASE_INTERNAL_URL=http://api-gw:8000
# Public publishable key (sb_publishable_...) or legacy anon JWT, injected at runtime.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend-only secret key (sb_secret_...) or legacy service_role JWT. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Self-host: db:5432 on the isolated Supabase Docker network; never a host port.
# Percent-encode the password. Quote the entire URI with single quotes in dotenv.
# The private local Docker connection uses sslmode=disable. Use verified TLS for external DBs.
SUPABASE_DB_URL=
# URI shape (not a real setting):
# postgresql://postgres:ENCODED_PASSWORD@db:5432/postgres?sslmode=disable
# No separate SUPABASE_DB_ADMIN_URL is passed. SUPABASE_DB_URL is still sensitive:
# postgres is a privileged role; verify its permissions before deployment.

# Independently generated per installation; preserve across restarts/rollbacks.
# INTERNAL_SECRET: random 32-byte hex.
# CPF_ENCRYPTION_KEY / WAHA_BYO_ENCRYPTION_KEY / AI_CRED_AES_KEY:
# independent random 32-byte BASE64 values (AI_CRED_AES_KEY must not be hex).
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
WAHA_BYO_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
# Separate database-side OAuth/webhook key: random 32-byte hex, preserved forever.
# Setting this variable alone does not seed private.app_secrets.
# Database initialization requires a separately approved write after the baseline.
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# Optional for first Web boot after the compatibility changes.
# Both blank: process-local limits/debounce and a degraded integration status.
# Configure both for shared limits/debounce; without them retain one worker and
# report the process-local fallback explicitly, including lack of cross-process coordination.
# Use an external staging Upstash-compatible endpoint; no local Redis in this stack.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional for first CRM-only Web boot after the compatibility changes.
# Unconfigured sending fails explicitly; health reports degraded, not operational.
# No WAHA container is created here.
# A real WhatsApp test also needs a provider and a private route for its callbacks.
# Keep these empty until real staging configuration is available.
# Do not substitute dummy keys or endpoints to bypass startup validation.
WAHA_API_BASE_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_BASE_URL=
WAHA_HMAC_SECRET=
# Set true only with a provider/proxy that actually signs webhook requests.
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false

AGENT_DISPATCH_CONSUMER=engine
AGENT_RUNTIME=pi

# Optional at first boot. Configure a model credential in the UI or environment
# before testing AI. Blank values are treated as absent by the worker loader.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Application mail; Supabase Auth SMTP is configured separately in its dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional later: VAPID, Google Calendar, WaCalls and SIP integrations.
# OWNER_PASSWORD is only supplied to the one-off bootstrap process, not stored here.
