# Worker de voz (SIP/ARI + IA em tempo real) — mesmo padrão do Dockerfile.worker:
# roda TS direto via tsx (sem build), imagem single-stage com devDeps.
FROM node:22-alpine

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/luckiest-draw/AiNativeCrm" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Pi Native CRM voice-agent"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
# `package.json` declara `pnpm.patchedDependencies`, e o pnpm lê o arquivo do
# patch durante o `install` — não no `postinstall`. Sem esta linha ele morre com
# ENOENT em `patches/@react-pdf__hyphenate.patch` e a imagem não nasce.
# `Dockerfile` e `Dockerfile.worker` já copiam; esta era a única que não copiava.
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . .

CMD ["pnpm", "exec", "tsx", "workers/voice-agent/index.ts"]
